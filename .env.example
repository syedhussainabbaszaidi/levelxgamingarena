APP_NAME=LevelXGamingArena
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=booking_zone
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — set MAIL_MAILER=smtp and fill in the SMTP details to deliver real email.
# With MAIL_MAILER=log every message is written to storage/logs (safe for local dev).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Where operational notifications are delivered (contact form + new bookings).
CONTACT_RECIPIENT=syed8069163@gmail.com
BOOKING_NOTIFICATION_EMAIL=syed8069163@gmail.com

# Public WhatsApp CTA. Falls back to the phone number in Admin → Settings.
# International format, digits only (no plus, spaces or dashes).
SITE_WHATSAPP_NUMBER=923422631057
SITE_WHATSAPP_MESSAGE="Hi, I would like to inquire about your gaming zone and activities."

# Activity image search. "library" uses the bundled gaming gallery (no key needed).
# Set to "pexels" and add an API key for live web image search.
IMAGE_SEARCH_PROVIDER=library
PEXELS_API_KEY=

# Relative URL prefix for the public storage disk (works on any host/port).
FILESYSTEM_PUBLIC_URL=/storage

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
